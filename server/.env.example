# Server Port
PORT=5000

# Node Environment ('development' | 'production')
NODE_ENV=development

# MongoDB Connection String
# Example: mongodb://localhost:27017/smitaa_divine_vision
# Or Atlas: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/smitaa_divine_vision?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/smitaa_divine_vision

# Client URL (for CORS allowance)
CLIENT_URL=http://localhost:5173

# Admin Secret Key for managing testimonials/content
ADMIN_API_KEY=smitaa_admin_dev_secret_key_change_in_production

# ===================================================================
# Razorpay Payment Gateway Credentials (Server-side only)
# Get your Key ID and Secret from Razorpay Dashboard -> Settings -> API Keys
# ===================================================================
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Official Direct Razorpay Payment Page Link (fallback if API keys not yet populated)
RAZORPAY_PAYMENT_LINK=https://razorpay.me/@diivinevision

# Business WhatsApp Phone Number (E.164 formatted without '+' sign)
# Smitaa Divine Vision official WhatsApp: 919119860551
WHATSAPP_BUSINESS_NUMBER=919119860551

# ===================================================================
# Owner Booking Notifications (Triggered strictly after verified payment)
# ===================================================================
# Email where booking confirmation details will be sent
OWNER_EMAIL=contact@smitaadivinevision.com

# SMTP Settings for Nodemailer (e.g., Gmail, SendGrid, Hostinger, AWS SES)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Smitaa Divine Vision Appointments" <contact@smitaadivinevision.com>

# Optional Webhook URL (e.g., Zapier, Make, Telegram bot, or internal CRM)
OWNER_NOTIFICATION_WEBHOOK_URL=
